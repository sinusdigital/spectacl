model DomainCitation {
  id        String   @id @default(uuid())
  promptId  String
  domain    String
  count     Int      // Total times cited across all analysis results
  presence  Int      // Number of analysis results containing this domain
  lastSeen  DateTime @updatedAt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  
  @@unique([promptId, domain])
  @@index([promptId, count(sort: Desc)])
}
