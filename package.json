    "ioredis": "^5.8.2",
    "ipaddr.js": "^2.4.0",
    "lightningcss": "1.30.2",
    "lightningcss-linux-x64-gnu": "1.30.2",
    "mcp-remote": "^0.1.38",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-vibrant": "^4.0.3",
