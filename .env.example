# ─── Database ─────────────────────────────────────────────────────────────────
# connection_limit must be >= worker concurrency (25) — Prisma defaults to
# num_cpus*2+1 (typically 9), which exhausts under load. pool_timeout is in seconds.
DATABASE_URL="postgresql://postgres:password@localhost:5432/spectacl?connection_limit=25&pool_timeout=10"

# ─── Redis (BullMQ, caching, rate limiting) ───────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Authentication (better-auth) ─────────────────────────────────────────────
BETTER_AUTH_SECRET="generate-a-random-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Deployment Mode ──────────────────────────────────────────────────────────
# "cloud" = SaaS with billing, payments, trials, plan limits
# "selfhosted" (or unset) = unlimited everything, no billing UI (default)
# NEXT_PUBLIC_SPECTACL_MODE="cloud"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"

# ─── Payments (Mollie) ────────────────────────────────────────────────────────
MOLLIE_API_KEY="test_xxxxxxxxxxxx"
# MOLLIE_WEBHOOK_URL="https://your-domain.com/api/webhooks/mollie"  # Optional — auto-derived from APP_URL

# ─── LLM Providers (at least one required for analysis) ──────────────────────
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxx"
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxx"
GOOGLE_API_KEY="AIzaxxxxxxxxxxxx"
MISTRAL_API_KEY="xxxxxxxxxxxx"

# ─── Google OAuth (optional — for SSO login) ──────────────────────────────────
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxx"

# ─── Cron Security ────────────────────────────────────────────────────────────
CRON_SECRET="generate-a-random-secret-here"

# ─── Optional ─────────────────────────────────────────────────────────────────
# INTERNAL_API_SECRET="generate-a-random-secret-here"   # Worker revalidation auth
# SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxx"                # Source map uploads
# SKIP_MAGIC_LINK_EMAIL="true"                           # Dev only — skip sending emails
